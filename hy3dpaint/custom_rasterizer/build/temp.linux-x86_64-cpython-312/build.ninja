ninja_required_version = 1.3
cxx = c++
nvcc = /opt/rocm/bin/hipcc

cflags = -pthread -fno-strict-overflow -Wsign-compare -Wunreachable-code -DNDEBUG -g -O3 -Wall -O3 -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer -fPIC -fPIC -I/home/jgroot/ComfyUI/.venv/lib/python3.12/site-packages/torch/include -I/home/jgroot/ComfyUI/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/home/jgroot/ComfyUI/.venv/lib/python3.12/site-packages/torch/include/THH -I/opt/rocm/include -I/home/jgroot/ComfyUI/.venv/include -I/home/jgroot/.local/share/uv/python/cpython-3.12.13-linux-x86_64-gnu/include/python3.12 -c
post_cflags = -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC -O3 -std=c++20 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=custom_rasterizer_kernel
cuda_cflags = -I/home/jgroot/ComfyUI/.venv/lib/python3.12/site-packages/torch/include -I/home/jgroot/ComfyUI/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/home/jgroot/ComfyUI/.venv/lib/python3.12/site-packages/torch/include/THH -I/opt/rocm/include -I/home/jgroot/ComfyUI/.venv/include -I/home/jgroot/.local/share/uv/python/cpython-3.12.13-linux-x86_64-gnu/include/python3.12 -c
cuda_post_cflags = -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -fPIC -DCUDA_HAS_FP16=1 -D__HIP_NO_HALF_OPERATORS__=1 -D__HIP_NO_HALF_CONVERSIONS__=1 -DHIP_ENABLE_WARP_SYNC_BUILTINS=1 -O3 -std=c++20 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=custom_rasterizer_kernel --offload-arch=gfx900 --offload-arch=gfx906 --offload-arch=gfx908 --offload-arch=gfx90a --offload-arch=gfx942 --offload-arch=gfx1030 --offload-arch=gfx1100 --offload-arch=gfx1101 --offload-arch=gfx1102 --offload-arch=gfx1200 --offload-arch=gfx1201 -fno-gpu-rdc
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags







